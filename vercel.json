{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "installCommand": "echo \"no dependencies to install\"",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/articles/ai-generated-books-scandal-what-libraries-need-to-know",
      "destination": "/articles/ai-books-scandal-tamil-nadu-library-audit-explained",
      "permanent": true
    },
    {
      "source": "/articles/from-cybertruck-s-edge-to-cybercab-s-horizon-tesla-s-bold-pivot-towards-an",
      "destination": "/articles/cybertruck-production-ends-tesla-s-pivot-to-cybercabs",
      "permanent": true
    },
    {
      "source": "/articles/tesla-s-bold-pivot-cybertruck-s-farewell-paves-the-way-for-the-robotaxi-rev",
      "destination": "/articles/cybertruck-production-ends-tesla-s-pivot-to-cybercabs",
      "permanent": true
    },
    {
      "source": "/articles/tesla-s-bold-pivot-elon-musk-signals-cybertruck-s-end-for-a-driverless-cybe",
      "destination": "/articles/cybertruck-production-ends-tesla-s-pivot-to-cybercabs",
      "permanent": true
    },
    {
      "source": "/articles/tesla-s-pivotal-shift-cybertruck-s-retreat-paves-way-for-the-autonomous-cyb",
      "destination": "/articles/cybertruck-production-ends-tesla-s-pivot-to-cybercabs",
      "permanent": true
    },
    {
      "source": "/articles/the-great-tesla-pivot-cybertruck-s-sunset-for-the-rise-of-cybercabs",
      "destination": "/articles/cybertruck-production-ends-tesla-s-pivot-to-cybercabs",
      "permanent": true
    },
    {
      "source": "/articles/the-sunset-of-cybertruck-tesla-s-strategic-pivot-towards-cybercabs-and-an-a",
      "destination": "/articles/cybertruck-production-ends-tesla-s-pivot-to-cybercabs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
