# ============================================================================
# SignalNest environment variables
# Copy to .env locally, or paste into Vercel (site vars) and n8n (workflow vars).
# NEVER commit a filled-in .env file. .gitignore already excludes it.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. SITE (Vercel build + workflows)
# ---------------------------------------------------------------------------
# Public base URL, no trailing slash. Used for canonicals, sitemap and og:url.
SITE_URL=https://signalnest.vercel.app

# Where the review page is served from. Must match Vercel's CORS allowlist.
ADMIN_ORIGIN=https://signalnest.vercel.app

# Optional. Leave empty until you have a real ID; empty means no analytics tag.
GA4_MEASUREMENT_ID=

# Optional newsletter endpoint (MailerLite, Buttondown, ConvertKit, formspree, etc.)
NEWSLETTER_ENDPOINT=

# ---------------------------------------------------------------------------
# 2. GITHUB (workflow writes)
# ---------------------------------------------------------------------------
# Fine-grained token, repository-scoped, "Contents: Read and write" only.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=signalnest
GITHUB_BRANCH=main

# ---------------------------------------------------------------------------
# 3. GOOGLE GEMINI (workflow 02)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Keep this identical to site.config.json -> gemini.model
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------
# 4. EDITORIAL APPROVAL (workflow 03)
# ---------------------------------------------------------------------------
# 32+ random bytes, hex or base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is the only secret the review page ever sends. It is never the GitHub token.
APPROVAL_SHARED_SECRET=

# Human reviewer recorded on every published article.
REVIEWER_NAME=

# ---------------------------------------------------------------------------
# 5. EDITORIAL THRESHOLDS
# ---------------------------------------------------------------------------
MIN_ARTICLE_WORDS=700
MIN_TOPIC_SCORE=6
DRAFTS_PER_RUN=1
# true  = draft straight from high-scoring discovered topics
# false = only draft topics an editor explicitly marked "queued"
AUTO_DRAFT_TOPICS=false

# ---------------------------------------------------------------------------
# 6. GOOGLE ANALYTICS + SEARCH CONSOLE (workflow 04)
# ---------------------------------------------------------------------------
# Numeric GA4 property id, NOT the G- measurement id. Leave either blank to
# produce an honest "unavailable" report instead of fabricated numbers.
GA4_PROPERTY_ID=
# Property URL as it appears in Search Console, e.g. https://signalnest.vercel.app/
# or sc-domain:signalnest.vercel.app
GSC_SITE_URL=
# Set to true only after attaching a Google OAuth2 credential to the two
# Google HTTP nodes in workflow 04.
GOOGLE_OAUTH_CONFIGURED=false

# ---------------------------------------------------------------------------
# 7. NOTIFICATIONS
# ---------------------------------------------------------------------------
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# 8. MONETISATION (optional, used only at build time)
# ---------------------------------------------------------------------------
# Leave BOTH empty until an ad network has actually approved this site.
# Empty means ads.txt carries a "no authorised sellers yet" comment and the
# ad slots stay disabled. Never paste a publisher id you do not own.
ADSENSE_CLIENT=
# Only set this if your ad network gave you an account-specific authorised
# seller line for ads.txt. Leave empty for the standard Google DIRECT line.
ADS_TXT_AUTH_DIRECT=
